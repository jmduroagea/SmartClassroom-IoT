# SmartClassroom settings.
# Copy this file to .env and change the values for your machine:
#     cp .env.example .env
# .env is ignored by git: never commit real addresses or passwords.
# Python programs read these variables in common/config.py.

# --- MQTT broker (every program) ---
# Machine that runs Mosquitto. On the sensors Pi: the IP of the brain Pi.
MQTT_HOST=localhost
MQTT_PORT=1883

# --- MongoDB (brain and web server only) ---
# On the brain Pi: the URI of the database on etu-web2.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=smartroom

# --- Sensors Pi ---
# Serial port of the RFID reader (UART).
RFID_SERIAL_PORT=/dev/serial0
# Folder of the Vosk speech model.
VOSK_MODEL_PATH=vosk-model-small-en-us-0.15

# --- Web server (read by server/web, not by Python) ---
PORT=3001
# Password to simulate and end emergencies from the web. Choose your own.
WEB_PASSWORD=change-me
